{
  "entity_name": "customers",
  "output_columns": [
    "customer_id",
    "email",
    "first_name",
    "last_name",
    "phone",
    "signup_date"
  ],
  "fields": {
    "customer_id": { "type": "string", "required": true, "min_length": 1 },
    "email": {
      "type": "string",
      "required": true,
      "regex": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$"
    },
    "first_name": { "type": "string", "required": true },
    "last_name": { "type": "string", "required": true },
    "phone": { "type": "string", "required": false },
    "signup_date": { "type": "date", "required": false, "format": "%Y-%m-%d" }
  },
  "cross_field_rules": [
    {
      "type": "at_least_one",
      "fields": ["email", "phone"],
      "message": "At least one contact field (email or phone) must be populated."
    }
  ]
}
