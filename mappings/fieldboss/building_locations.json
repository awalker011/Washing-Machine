{
  "entity_name": "Building Locations",
  "schema": "Building Locations",
  "source_patterns": ["*.xlsx", "Building Locations*.csv"],
  "sheet_name": "Building Locations",
  "target_file": "Building Locations.csv",
  "error_file": "Building Locations_errors.csv",
  "field_mappings": {
    "Name": "Name*",
    "Legacy Building #": "Legacy Building #",
    "# Elevators": "# Elevators",
    "Customer (Account - for Invoicing)": "Customer (Account - for Invoicing)",
    "Building Owner (Account - Optional)": "Building Owner (Account - Optional)",
    "Property Manager (Company)": "Property Manager (Company)",
    "Price List": "Price List",
    "Tax Schedule": "Tax Schedule",
    "Tax Rate": "Tax Rate",
    "Local": "Local",
    "Street": "Street",
    "Unit": "Unit",
    "City": "City",
    "Province / State": "Province / State",
    "Postal / Zip": "Postal / Zip",
    "Property Manager (Contact)": "Property Manager (Contact)",
    "Contact (On Site)": "Contact (On Site)",
    "Print Invoice": "Print Invoice",
    "Email Invoice": "Email Invoice",
    "Manually Send Invoice": "Manually Send Invoice",
    "Billing Contact 1": "Billing Contact 1",
    "Billing Contact 2": "Billing Contact 2",
    "Billing Contact 3": "Billing Contact 3",
    "Billing Contact 4": "Billing Contact 4",
    "Primary Tech": "Primary Tech",
    "Salesperson": "Salesperson",
    "Scheduling Notes (access)": "Scheduling Notes (access)"
  },
  "transformations": {
    "Name*": ["trim", "collapse_whitespace"],
    "Customer (Account - for Invoicing)": ["trim", "collapse_whitespace"],
    "Building Owner (Account - Optional)": ["trim", "collapse_whitespace"],
    "Property Manager (Company)": ["trim", "collapse_whitespace"],
    "Property Manager (Contact)": ["trim", "collapse_whitespace"],
    "Contact (On Site)": ["trim", "collapse_whitespace"],
    "Billing Contact 1": ["trim", "collapse_whitespace"],
    "Billing Contact 2": ["trim", "collapse_whitespace"],
    "Billing Contact 3": ["trim", "collapse_whitespace"],
    "Billing Contact 4": ["trim", "collapse_whitespace"],
    "Street": ["trim", "collapse_whitespace"],
    "Unit": ["trim", "collapse_whitespace"],
    "City": ["trim", "collapse_whitespace"],
    "Province / State": [
      "trim",
      "collapse_whitespace",
      {
        "name": "normalize_region_code"
      }
    ],
    "Postal / Zip": ["trim", "uppercase"]
  }
}
