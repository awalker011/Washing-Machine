{
  "entity_name": "Contacts",
  "schema": "Contacts",
  "source_patterns": ["*.xlsx", "Contacts*.csv"],
  "sheet_name": "Contacts",
  "target_file": "Contacts.csv",
  "error_file": "Contacts_errors.csv",
  "field_mappings": {
    "First Name": "First Name",
    "Last Name": "Last Name*",
    "Full Name (Auto)": "Full Name (Auto)",
    "Company Name (Account)": "Company Name (Account)",
    "Contact Type": "Contact Type",
    "Job Title": "Job Title",
    "Email": "Email",
    "Business Phone": "Business Phone",
    "Mobile Phone": "Mobile Phone",
    "Fax": "Fax",
    "Description": "Description",
    "Send maintenance time ticket": "Send maintenance time ticket",
    "Send trouble call time ticket": "Send trouble call time ticket",
    "Email trouble call confirmation": "Email trouble call confirmation"
  },
  "transformations": {
    "First Name": ["trim", "collapse_whitespace"],
    "Last Name*": ["trim", "collapse_whitespace"],
    "Full Name (Auto)": [
      {
        "name": "concat_fields",
        "fields": ["First Name", "Last Name*"],
        "separator": " ",
        "only_if_blank": true
      },
      "trim",
      "collapse_whitespace"
    ],
    "Company Name (Account)": ["trim", "collapse_whitespace"],
    "Email": ["trim", "lowercase"],
    "Business Phone": ["trim"],
    "Mobile Phone": ["trim"],
    "Fax": ["trim"]
  }
}
